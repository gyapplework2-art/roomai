# Background worker only. Never expose this value to the Next.js browser/client.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only. Prefer SUPABASE_SECRET_KEY for new sb_secret_ keys.
# SUPABASE_SERVICE_ROLE_KEY=

CRAWLER_ENV=development
CRAWLER_LOG_LEVEL=INFO
CRAWLER_USER_AGENT=RoomAI-CatalogCrawler/0.1 (+https://example.com)
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_MIN_REQUEST_INTERVAL_SECONDS=1
CRAWLER_MAX_RETRIES=2
CRAWLER_RETRY_BACKOFF_SECONDS=0.5

# Catalog persistence is disabled by default. Set true only for an explicitly approved backend write.
CATALOG_ALLOW_WRITES=false
CATALOG_MAX_PRODUCTS_PER_EXECUTION=1
