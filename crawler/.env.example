# Background worker only. Never expose this value to the Next.js browser/client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CRAWLER_ENV=development
CRAWLER_LOG_LEVEL=INFO
CRAWLER_USER_AGENT=RoomAI-CatalogCrawler/0.1 (+https://example.com)
CRAWLER_REQUEST_TIMEOUT_SECONDS=20
CRAWLER_MIN_REQUEST_INTERVAL_SECONDS=1
